# Ép LF cho toàn bộ file text — tránh Git tự đổi sang CRLF trên Windows
# (core.autocrlf=true). Quan trọng nhất với *.sh: CRLF làm hỏng dòng
# #!/bin/bash khi chạy trong môi trường Linux thật (container/WSL nghiêm ngặt).
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.json text eol=lf

# File nhị phân — không đụng line ending
*.jar binary
*.png binary
*.zip binary
